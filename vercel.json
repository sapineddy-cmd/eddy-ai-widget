{
  "version": 2,
  "builds": [
    { "src": "eddy.js",    "use": "@vercel/node" },
    { "src": "eddy_v2.js", "use": "@vercel/node" },
    { "src": "public/",  "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/health",     "dest": "/eddy.js" },
    { "src": "/api/reply",      "dest": "/eddy.js" },

    { "src": "/api/health-v2",  "dest": "/eddy_v2.js" },
    { "src": "/api/reply-v2",   "dest": "/eddy_v2.js" },

    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
