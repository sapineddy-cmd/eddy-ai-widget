{
  "version": 2,
  "builds": [
    { "src": "eddy.js", "use": "@vercel/node" },
    { "src": "public/", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/eddy.js" },
    { "src": "/widget.js", "dest": "/public/widget.js" },
    { "src": "/", "dest": "/eddy.js" }
  ]
}
